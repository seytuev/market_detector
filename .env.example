# Секреты и настройки сервиса HTF Zones (§11 п.8: только на сервере)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
HTF_AUTH_TOKEN=change-me
# Локально — файл в ./data. На Railway при прикреплённом томе файл кладётся
# в RAILWAY_VOLUME_MOUNT_PATH: слой контейнера на каждом деплое пустой.
HTF_DB_PATH=data/htf_zones.db
# PostgreSQL в Railway: ссылка на ${{Postgres.DATABASE_URL}}.
# HTF_DB_PATH остаётся источником первого переноса и каталогом файлов.
# При заданном DATABASE_URL приложение не переключается на SQLite при ошибке.
DATABASE_URL=
HTF_HOST=0.0.0.0
HTF_PORT=8000
# Период опроса в секундах; по умолчанию 1800 (30 мин). Уменьшите,
# если нужна более быстрая реакция на касания между закрытиями свечей:
# HTF_POLL_SECONDS=1800
# Публичный URL сайта для кнопки «Открыть график» в Telegram
# (обязателен, когда сервис за прокси или HTF_HOST=0.0.0.0), пример:
# HTF_PUBLIC_BASE_URL=https://htf.example.com
HTF_PUBLIC_BASE_URL=

# --- Этап 3: realtime-поток Binance Spot по WebSocket (спека §7) ---
# По умолчанию выключен — опрос идёт по REST, поведение прежнее (AC21):
# HTF_REALTIME_ENABLED=false
# Базовый URL маркет-стримов Binance (обычно менять не нужно):
# HTF_BINANCE_WS_URL=wss://stream.binance.com:9443
# Секунд без сообщений до переподключения (kline-стрим шлёт обновления
# каждые ~2 с, молчание дольше — мёртвое соединение):
# HTF_WS_IDLE_TIMEOUT=120
# Плановая ротация соединения, секунды (Binance разрывает соединение
# через 24 ч — ротируем заранее, 82800 ≈ 23 ч):
# HTF_WS_LIFETIME_S=82800
# Backoff переподключения: база и потолок экспоненты (×2, джиттер ±20%):
# HTF_WS_RECONNECT_BASE_S=1
# HTF_WS_RECONNECT_CAP_S=60
# --- Этап 4: очередь расчётов закрытых свечей (спека §9) ---
# По умолчанию ВКЛЮЧЕНА — основной путь обработки; false возвращает
# прежний синхронный расчёт внутри sync_candles (откат этапа):
# HTF_CALC_QUEUE_ENABLED=true
# Потребители очереди расчётов (тяжёлые вызовы движка всё равно
# сериализуются глобальным calc-замком — >1 только перекрывает ожидание):
# HTF_CALC_CONCURRENCY=1
# --- Этап 5: ограниченная параллельность REST (спека §10) ---
# Одновременных запросов к одному источнику (свечи разных инструментов);
# стартовое значение — прежнее, увеличивать после baseline-замеров:
# HTF_REST_CONCURRENCY=2
# Переопределения детектора (необязательно), пример:
# HTF_DET_CLUSTER_TOLERANCE_PCT=0.02
# HTF_DET_NOTIFY_ONLY_REVIEWED=false
# Какие HTF-зоны D1/W1 запускают LTF-наблюдение (§16.1): по умолчанию OB.
# Чтобы наблюдения (и «Ожидаемый BOS» в LONG/SHORT) открывались и от FVG:
# HTF_DET_HTF_CONTEXT_TYPES=OB,FVG

# --- Модуль «Альткоины D1» (отдельный сектор, страница /alt.html) ---
# Ключ CoinMarketCap для ежедневного снапшота вселенной (ранги 11–300);
# без ключа дневной job завершается статусом no_universe — анализ выборки
# недоступен, список не выдумывается
CMC_API_KEY=
# Базовые URL внешних API (обычно менять не нужно)
CMC_BASE_URL=https://pro-api.coinmarketcap.com
BYBIT_BASE_URL=https://api.bybit.com
# Основные переопределения модуля (ENV вида HTF_ALT_<FIELD>, все опциональны):
# HTF_ALT_DRAWDOWN_THRESHOLD=0.80           # просадка от ATH для входа в поиск
# HTF_ALT_FORMING_MIN_DAYS=50               # строго больше → forming (с 51 дня)
# HTF_ALT_MATURE_MIN_DAYS=100               # строго больше → mature (с 101 дня)
# HTF_ALT_RETEST_WINDOW_DAYS=14             # дедлайн ретеста после breakout
# HTF_ALT_CLASSIFIER_SLOPE_MAX=0.50         # порог наклона классификатора боковика
# HTF_ALT_CLASSIFIER_CENTER_SHIFT_MAX=0.50  # порог сдвига центра
# HTF_ALT_CANCEL_MODE=wick_on_closed_d1     # wick_on_closed_d1 | close_on_closed_d1 (проектный выбор v1)
# HTF_ALT_JOB_HOUR_MSK=3                    # расписание дневного job (МСК)
# HTF_ALT_JOB_MINUTE_MSK=15
# HTF_ALT_JOB_ENABLED=true                  # false — выключить job
# HTF_ALT_CMC_RANK_MIN=11                   # границы выборки CMC по рангу
# HTF_ALT_CMC_RANK_MAX=300
# HTF_ALT_VENUE_PREFERENCE=binance,bybit    # приоритет площадки (csv)
# HTF_ALT_QUOTE_PREFERENCE=USDT,USDC        # приоритет валюты котировки (csv)

# Stabilization: daily consistent backups and maintenance
HTF_BACKUP_ENABLED=1
HTF_BACKUP_INTERVAL_HOURS=24
# Market HTTP clients: 0 = direct connection, 1 = use HTTPX environment
# (HTTP_PROXY/HTTPS_PROXY/ALL_PROXY and custom CA environment settings).
HTF_MARKET_TRUST_ENV=1

# Информационный контекст и катализаторы, перенесённые из STVTerminal.
# Node.js >=18 нужен для исходных TS-модулей (готовая сборка входит в пакет).
RESEARCH_ENABLED=0
RESEARCH_CONTEXT_UI_ENABLED=1
# Авторазбор новых Telegram-постов (последние 7 дней), в пределах общего бюджета модели.
RESEARCH_TELEGRAM_ANALYSIS_ENABLED=1
# Дайджест за 24ч при изменении данных, не чаще раза в 30 минут.
RESEARCH_TELEGRAM_DIGEST_ENABLED=1
RESEARCH_DERIBIT_ENABLED=0
RESEARCH_NOTIFICATIONS_ENABLED=0
# Необязательный перенос обновлений из отдельного экземпляра терминала.
# Для встроенного сборщика публичных Telegram-каналов оставьте пустыми.
RESEARCH_TERMINAL_URL=
RESEARCH_INTEGRATION_TOKEN=
RESEARCH_SYNC_INTERVAL_SECONDS=300
RESEARCH_SYNC_PAGE_SIZE=100
RESEARCH_HTTP_TIMEOUT_SECONDS=15
# RESEARCH_NODE_PATH=C:/Program Files/nodejs/node.exe

# Дополнительные исследовательские сервисы: независимое включение.
RESEARCH_IDEAS_ENABLED=0
RESEARCH_STRENGTH_ENABLED=0
RESEARCH_BASKETS_ENABLED=0
RESEARCH_PLAYBOOK_ENABLED=0
RESEARCH_PLAYBOOK_MATCHING_ENABLED=0
RESEARCH_PLAYBOOK_MEMORY_ENABLED=0
RESEARCH_LAB_ENABLED=0
# Провайдер использует те же переменные, что STVTerminal.
# Railway-переменная XAI поддерживается как псевдоним XAI_API_KEY.
# LLM_PROVIDER=xai
# LLM_CHEAP_MODEL=grok-4.3
# LLM_STRONG_MODEL=grok-4.3
# XAI_API_KEY=
# До задания бюджета платные задания запрещены. Окно бюджета — скользящие 24ч.
RESEARCH_MODEL_DAILY_USD=0
RESEARCH_MODEL_MAX_CALL_USD=0
# Необязательные актуальные тарифы; без них в лимите учитывается весь резерв.
# RESEARCH_MODEL_INPUT_USD_PER_MILLION=
# RESEARCH_MODEL_OUTPUT_USD_PER_MILLION=
# Отслеживаемые Telegram-каналы и X-аккаунты задаются в Настройки → Импорт Telegram / X.
# Для прямого чтения выбранных X-аккаунтов нужен серверный Bearer Token с доступом к X API.
# Ключ xAI для моделей и токен X API — отдельные подключения.
# X_BEARER_TOKEN=
