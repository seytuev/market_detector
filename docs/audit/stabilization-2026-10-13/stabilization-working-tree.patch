+# --------------------------------------------------------------------- #
+# Рестарт: остаток spool'а поднимается и дочитывается; протухший флаг
+# degraded без строк снимается на старте
+# --------------------------------------------------------------------- #
+
+async def test_spool_survives_restart_and_stale_degraded_flag_is_cleared():
