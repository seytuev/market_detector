+    async def klines(self, symbol, tf, start, end, include_forming=False):
+        rows = self.rows.get((symbol, tf), [])
+        return [
+            replace(c) for c in rows
+            if start <= c.open_time <= end and (include_forming or c.closed)
+        ]
